# Bot mode: "polling" or "webhook"
BOT_MODE=polling

# Webhook settings (only if BOT_MODE=webhook)
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_SECRET=change_me_webhook_secret

# Database
DATABASE_URL=postgresql+asyncpg://maxbot:maxbot_pass@db:5432/maxbot
# For sync alembic migrations:
SYNC_DATABASE_URL=postgresql://maxbot:maxbot_pass@db:5432/maxbot

# Security
SECRET_KEY=change_me_super_secret_key_at_least_32_chars

# Token encryption key (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=CHANGE_ME_generate_with_fernet_generate_key

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Admin seed (created on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Postgres (used by docker-compose)
POSTGRES_DB=maxbot
POSTGRES_USER=maxbot
POSTGRES_PASSWORD=maxbot_pass
